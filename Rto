--------------------------------------------------
-- PLAYER BOX
--------------------------------------------------

local function removeBox(target)

	local character = target.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local old = root:FindFirstChild("BanPaPlayerBox")

	if old then
		old:Destroy()
	end
end

local currentBoxSize = config.BoxSize

local function createBox(target)

	if target == player then
		return
	end

	local character = target.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local old = root:FindFirstChild("BanPaPlayerBox")

	if old then
		old.Size = currentBoxSize
		return
	end

	local box = Instance.new("BoxHandleAdornment")

	box.Name = "BanPaPlayerBox"
	box.Adornee = root

	box.Size = currentBoxSize

	box.Color3 = config.BoxColor
	box.Transparency = config.BoxTransparency

	box.AlwaysOnTop = true
	box.ZIndex = 5

	box.Parent = root
end

local function updateBoxes()

	for _, target in ipairs(Players:GetPlayers()) do

		if boxEnabled then
			createBox(target)
		else
			removeBox(target)
		end

	end

end

